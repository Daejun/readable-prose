{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}\"/hooks/writing-rules.md"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/require-skill.py"
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/require-skill.py"
          }
        ]
      }
    ]
  }
}
